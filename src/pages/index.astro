---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en-US">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero { text-align: center; margin: 3rem 0 2rem 0; }
			.hero h1 { font-size: 2.5rem; margin-bottom: 0.5rem; }
			.hero p { font-size: 1.2rem; color: var(--gray); max-width: 600px; margin: 0 auto; }
			
			main { max-width: 1000px !important; margin: 0 auto; padding: 2em; }
			
			/* Grid layout for Cards */
			.card-grid { 
				display: grid; 
				grid-template-columns: repeat(3, 1fr); 
				gap: 1.5rem; 
				margin: 3rem 0; 
			}
			@media (max-width: 800px) {
				.card-grid { grid-template-columns: 1fr; }
			}
			
			/* Card Base Styling */
			.card { 
				position: relative; 
				border-radius: 12px; 
				overflow: hidden; 
				box-shadow: 0 4px 15px rgba(0,0,0,0.1); 
				display: block; 
				background: #111;
				text-decoration: none !important;
			}
			
			.card img { 
				width: 100%; 
				aspect-ratio: 16 / 9;
				object-fit: cover; 
				transition: transform 0.4s ease, opacity 0.4s ease; 
				display: block; 
			}
            
            .placeholder-img {
                width: 100%; 
				aspect-ratio: 16 / 9;
				background: linear-gradient(135deg, #1e1e1e 0%, #2d2d2d 100%);
                display: flex;
                align-items: center;
                justify-content: center;
                color: #555;
                font-weight: bold;
                transition: transform 0.4s ease, opacity 0.4s ease; 
            }
			
			/* Hover State */
			.card:hover img, .card:hover .placeholder-img { 
				transform: scale(1.1); 
				opacity: 0.3;
			}
			
			/* Hover Text Popup Overlay */
			.card-overlay {
				position: absolute; 
				top: 0; 
				left: 0; 
				width: 100%; 
				height: 100%;
				display: flex; 
				flex-direction: column; 
				justify-content: center; 
				align-items: center;
				opacity: 0; 
				transition: opacity 0.3s ease; 
				text-align: center; 
				padding: 1.5rem;
				box-sizing: border-box;
			}
			
			.card:hover .card-overlay { 
				opacity: 1; 
			}
			
			.overlay-title { 
				font-size: 1.2rem; 
				font-weight: 700; 
				margin-bottom: 0.5rem; 
				color: #ffffff; 
				line-height: 1.2;
			}
			
			.overlay-text { 
				font-size: 0.9rem; 
				margin-bottom: 1.2rem; 
				color: #e0e0e0; 
				line-height: 1.4;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;  
				overflow: hidden;
			}
			
			.btn { 
				background: #ff9900; 
				color: #fff; 
				padding: 0.5rem 1rem; 
				border-radius: 6px; 
				font-weight: bold; 
				transition: background 0.2s;
				font-size: 0.9rem;
			}
			
			.btn:hover { background: #e68a00; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">
				<h1>🚀 Dominate Amazon FBA in 2026</h1>
				<p>We test, review, and compare the top Amazon FBA software suites to help you scale your business.</p>
			</div>

			<!-- Dynamic Blog Cards -->
			<div class="card-grid">
				{
					posts.map((post) => (
						<a href={`/blog/${post.id}/`} class="card">
							{post.data.heroImage ? (
								<Image width={600} height={350} src={post.data.heroImage} alt={post.data.title} />
							) : (
								<div class="placeholder-img">Image Coming Soon</div>
							)}
							<div class="card-overlay">
								<div class="overlay-title">{post.data.title.replace(/2026/g, new Date().getFullYear().toString())}</div>
								<div class="overlay-text">{post.data.description.replace(/2026/g, new Date().getFullYear().toString())}</div>
								<span class="btn">Read Article</span>
							</div>
						</a>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>
